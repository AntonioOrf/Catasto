{
  "name": "catasto-backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts src/scripts/migrate.ts --format esm --clean --minify",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:migrate:prod": "node dist/scripts/migrate.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@catasto/shared": "*",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "mysql2": "^3.18.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "tsup": "^8.3.6",
    "tsx": "^4.19.3",
    "typescript": "^5.3.3",
    "vitest": "^3.2.7"
  }
}
