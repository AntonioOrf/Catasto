MYSQL_ROOT_PASSWORD=password_segreta_root
MYSQL_DATABASE=catasto_db
MYSQL_USER=catasto_user
MYSQL_PASSWORD=catasto_password

# --- Segnalazioni utenti ---
# Salt per l'hash degli IP dei segnalatori. Obbligatorio in produzione: senza,
# il backend rifiuta di registrare una segnalazione. Stringa casuale lunga,
# da non ruotare (ruotarla azzera la correlazione anti-abuso storica).
SEGNALAZIONI_SALT=stringa_casuale_lunga

# Inoltro via email delle proposte di segnatura della portata (FormSubmit).
# Indirizzo della redazione, oppure (consigliato) l'alias casuale che
# FormSubmit invia dopo l'attivazione, che non espone l'email. Al primo invio
# FormSubmit manda un'email di attivazione: finché non viene confermata le
# notifiche non arrivano. Vuota = nessuna email (le segnalazioni restano nel DB).
FORMSUBMIT_EMAIL=
# URL pubblico del portale, inviato a FormSubmit come Origin/Referer (il form
# viene legato a questo dominio). Se vuota si usa la prima origine di CORS_ORIGIN.
FORMSUBMIT_ORIGIN=https://catasto.example.org

# Token dell'area di moderazione (GET/PATCH /api/segnalazioni), inviato come
# header `Authorization: Bearer <token>`. Senza questa variabile le rotte di
# moderazione restano chiuse.
ADMIN_TOKEN=token_moderazione_segreto

# Numero di reverse proxy davanti al backend (1 con il nginx del compose).
# Serve a far vedere a Express l'IP reale del client per rate limit e
# anti-abuso. Non impostarlo se il backend è esposto direttamente: renderebbe
# falsificabile X-Forwarded-For.
TRUST_PROXY=1

# Origini ammesse dal CORS, separate da virgola (es. https://catasto.example.org).
# Con il compose il frontend chiama /api sullo stesso dominio e il CORS non
# serve: impostala solo se un frontend su un altro dominio usa questa API.
CORS_ORIGIN=
