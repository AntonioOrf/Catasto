# Copiare in /etc/catasto/catasto.env (permessi 600, proprietario root).
# Tutti i valori sono fittizi. Descrizione completa: docs/backend.md §9.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=catasto_user
DB_PASSWORD=cambiami
DB_NAME=catasto
DB_SSL=false
SEGNALAZIONI_SALT=stringa_casuale_lunga
ADMIN_TOKEN=token_moderazione_segreto
MODERAZIONE_SECRET=
FORMSUBMIT_EMAIL=
FORMSUBMIT_ORIGIN=https://catasto.example.org
PUBLIC_API_URL=
# 1 se davanti c'è il reverse proxy dell'ateneo e la porta 3005 non è
# raggiungibile da fuori
TRUST_PROXY=
CORS_ORIGIN=
# mysql se più VM servono il portale dietro un bilanciatore
SHARED_STATE=
